GEMINI_API_KEY=

Создать или взять ключ можно в https://aistudio.google.com/api-keys

TELEGRAM_BOT_API_KEY=

Создать или взять ключ можно в https://t.me/BotFather

# --- Прокси только для Telegram + Gemini (VPS / SkyNode) ---
# Локальный mihomo: http://127.0.0.1:7890 (без TUN). На Windows/локалке
# оставь пустым — бот ходит напрямую.
# НЕ задавай системные HTTP_PROXY/HTTPS_PROXY/ALL_PROXY на процесс бота:
# иначе NocoDB / SMTP / Nominatim тоже уедут в VPN.
OUTBOUND_HTTPS_PROXY=
# Опциональные алиасы (если пусто — берётся OUTBOUND_HTTPS_PROXY):
TELEGRAM_PROXY=
GEMINI_HTTPS_PROXY=

# Обратная связь и консольные ошибки → письмо на почту (SMTP Yandex) — БЕЗ прокси
FEEDBACK_TO_EMAIL=gog.ortey@yandex.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=gog.ortey@yandex.ru
SMTP_PASSWORD=

# Пароль приложения Yandex (не обычный пароль от почты):
# https://id.yandex.ru/security/app-passwords
# Нужен доступ «Почта», затем вставить пароль сюда.
# Тот же SMTP: отзывы пользователей + ошибки консоли (тема с 🟨⬛🍎).


NOCODB_SKYNODE_API_KEY=

Ключ доступа к api БД через NocoDB 
Получается у меня в https://skynode.nocodb.api.gogortey.ru/account/tokens

Swagger: https://skynode.nocodb.api.gogortey.ru/api/v3/meta/bases/p6iywpukq1yiryf/swagger
